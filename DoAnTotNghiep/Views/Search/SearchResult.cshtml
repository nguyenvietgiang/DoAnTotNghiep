@model IEnumerable<DoAnTotNghiep.Models.ResponseDTO.JobPostingResponseDto>

@{
    ViewData["Title"] = "Tìm kiếm công việc";
}
@if (Model.Any())
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="card-title">Kết quả tìm kiếm</h2>
            <div class="card-deck">
                @foreach (var jobPosting in Model)
                {
                    <div class="card">
                        <div class="row no-gutters">
                            <!-- Ảnh bên trái -->
                            <div class="col-md-4">
                                <img src="@jobPosting.Image" class="card-img" alt="Job Image" />
                            </div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <h5 class="card-title">@jobPosting.Title</h5>
                                    <p class="card-text">Position: @jobPosting.Position</p>
                                    <p class="card-text">Location: @jobPosting.Location</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <p>No results found.</p>
}

