@model DoAnTotNghiep.Models.EntityModels.JobPosting
@{
    ViewData["Title"] = "Chi tiết công việc";
}

<!-- job post company Start -->
<div class="job-post-company pt-120 pb-120">
    <div class="container">
        <div class="row justify-content-between">
            <!-- Left Content -->
            <div class="col-xl-7 col-lg-8">
                <!-- job single -->
                <div class="single-job-items mb-50">
                    <div class="job-items">
                        <div class="company-img company-img-details">
                            <a ><img src="@Model.Employer.UrlImage"></a>
                        </div>
                        <div class="job-tittle">
                            <a href="">
                                <h4>@Model.Title</h4>
                            </a>
                            <ul>
                                <li>@Model.Employer.CompanyName</li>
                                <li><i class="fas fa-map-marker-alt"></i>@Model.Location</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <!-- job single End -->

                <div class="job-post-details">
                    <div class="post-details1 mb-50">
                        <!-- Small Section Tittle -->
                        <div class="small-section-tittle">
                            <h4>Mô tả công việc</h4>
                        </div>
                        <p class="lead card-text"> @Html.Raw(Model.Description)</p>
                    </div>
                    <div class="post-details2  mb-50">
                        <!-- Small Section Tittle -->
                        <div class="small-section-tittle">
                            <h4>Yêu cầu kỹ năng</h4>
                        </div>
                        <p class="lead card-text"> @Html.Raw(Model.Requirements)</p>
                    </div>
                    <div class="post-details2  mb-50">
                        <!-- Small Section Tittle -->
                        <div class="small-section-tittle">
                            <h4></h4>
                        </div>
                        <p class="lead card-text"> @Html.Raw(Model.benefits)</p>
                    </div>
                </div>

            </div>
            <!-- Right Content -->
            <div class="col-xl-4 col-lg-4">
                <div class="post-details3  mb-50">
                    <!-- Small Section Tittle -->
                    <div class="small-section-tittle">
                        <h4>Tổng quan công việc</h4>
                    </div>
                    <ul>
                        <li>Ngày đăng : <span>@Model.CreateAt</span></li>
                        <li>Địa điểm : <span>@Model.Location</span></li>
                        <li>Số lượng : <span>@Model.Number</span></li>
                        <li>Vị trí : <span>@Model.position</span></li>
                        <li>Lương :  <span>@Model.Salary VND</span></li>
                    </ul>
                    <div class="apply-btn2">
                        <!-- Button trigger modal -->
                        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#RecruitmentModal">
                            Launch demo modal
                        </button>
                    </div>
                </div>
                <div class="post-details4  mb-50">
                    <!-- Small Section Tittle -->
                    <div class="small-section-tittle">
                        <h4>Công ty tuyển dụng</h4>
                    </div>
                    <span>@Model.Employer.CompanyName</span>
                    <ul>
                        <li>Lĩnh vực: <span>@Model.Employer.Industry </span></li>
                        <li>Số lượng nhân viên : <span>@Model.Employer.CompanySize</span></li>
                        <li>Emai: <span>carrier.colorlib@gmail.com</span></li>
                    </ul>
                    <div class="d-flex pt-2">
                <p class="text-dark font-weight-medium mb-0 mr-2">Chia sẻ với:</p>
                <div class="d-inline-flex">
                            <button class="genric-btn primary small" onclick="shareOnFacebook()">
                        <i class="fab fa-facebook-f"></i>
                    </button>
                    |
                    <button class="genric-btn primary small" onclick="shareOnTwitter()">
                        <i class="fab fa-twitter"></i>
                    </button>
                </div>
            </div>
                </div>
            </div>
        </div>
    </div>
</div> 

<div class="modal fade" id="RecruitmentModal" tabindex="-1" role="dialog" aria-labelledby="RecruitmentModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="RecruitmentModalTitle">Ứng tuyển vị trí</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <form>
          <div class="form-group">
            <label for="userName">Tên người dùng:</label>
            <input type="text" class="form-control" id="userName" placeholder="Nhập tên của bạn">
          </div>
          <div class="form-group">
            <label for="userEmail">Email:</label>
            <input type="email" class="form-control" id="userEmail" placeholder="Nhập địa chỉ email của bạn">
          </div>
          <div class="form-group">
            <label for="userPhone">Số điện thoại:</label>
            <input type="tel" class="form-control" id="userPhone" placeholder="Nhập số điện thoại của bạn">
          </div>
          <div class="form-group">
            <label for="userFile">Chọn file:</label>
            <input type="file" class="form-control-file" id="userFile">
          </div>
          <div class="form-group">
            <label for="userDescription">Mô tả chi tiết:</label>
            <textarea class="form-control" id="userDescription" rows="3" placeholder="Nhập mô tả chi tiết về bản thân"></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="genric-btn danger radius" data-dismiss="modal">Hủy</button>
        <button type="button" class="genric-btn success radius">Ứng tuyển ngay</button>
      </div>
    </div>
  </div>
</div>
