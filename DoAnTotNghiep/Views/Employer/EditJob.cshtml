@model DoAnTotNghiep.Models.EntityModels.JobPosting
@{
    ViewData["Title"] = "Chỉnh sửa tin tuyển dụng";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title">Chỉnh sửa tin tuyển dụng</h2>

                    <form asp-action="EditJob">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="JobPostingID" />

                        <div class="form-group">
                            <p>Tiêu đề</p>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <p>Mô tả công việc</p>
                            <textarea id="editor1" asp-for="Description" class="form-control"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <p>Địa chỉ</p>
                            <input asp-for="Location" class="form-control" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <p>Yêu cầu tuyển dụng</p>
                            <textarea id="editor2" asp-for="Requirements" class="form-control"></textarea>
                            <span asp-validation-for="Requirements" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <p>Số lượng tuyển dụng</p>
                            <input asp-for="Number" class="form-control" />
                            <span asp-validation-for="Number" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <p>Lương cơ bản</p>
                            <input asp-for="Salary" class="form-control" />
                            <span asp-validation-for="Salary" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <p>Vị trí tuyển dụng </p>
                            <input asp-for="position" class="form-control" />
                            <span asp-validation-for="position" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <p>Phúc lợi</p>
                            <textarea id="editor3" asp-for="benefits" class="form-control"></textarea>
                            <span asp-validation-for="benefits" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <p>Thời gian làm việc</p>
                            <input asp-for="WorkingTime" class="form-control" />
                            <span asp-validation-for="WorkingTime" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        CKEDITOR.replace('editor1');
        CKEDITOR.replace('editor2');
        CKEDITOR.replace('editor3');
    </script>
}