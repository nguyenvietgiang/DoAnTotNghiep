@model IEnumerable<DoAnTotNghiep.Models.ResponseDTO.JobPostingResponseDto>

@{
    ViewData["Title"] = "Danh sách tuyển dụng của tôi";
}
<div class="card mb-4 rounded">
    <div class="card-body">
        <h2 class="card-title">Danh sách tuyển dụng của tôi</h2>
        <div class="card-deck">
            @if (Model.Any())
            {
                @foreach (var jobPosting in Model)
                {
                    <div class="single-job-items mb-30">
                        <div class="job-items">
                            <div class="company-img">
                                <a href="@Url.Action("Conpany", "Home", new { @id = jobPosting.CompanyId })">
                                    <img src="@jobPosting.Image" alt="@jobPosting.Title">
                                </a>
                            </div>
                            <div class="job-tittle job-tittle2">
                                <a href="@Url.Action("DetailJob", "Search", new { @id = jobPosting.JobId })">
                                    <h4>@jobPosting.Title</h4>
                                </a>
                                <ul>
                                    <li>@jobPosting.Position</li>
                                    <li><i class="fas fa-map-marker-alt"></i>@jobPosting.Location</li>
                                    <li>@jobPosting.Salary VND</li>
                                </ul>
                            </div>
                        </div>
                        <div class="items-link items-link2 f-right">
                            <a href="@Url.Action("ApplyList", "Employer", new { @JobId = jobPosting.JobId })">DS Ứng tuyển</a>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>Bạn chưa đăng tin tuyển dụng nào.</p>
            }
        </div>
        <a class="btn btn-success" asp-controller="Employer" asp-action="CreateJobPosting">Đăng tin tuyển dụng</a>
    </div>
</div>