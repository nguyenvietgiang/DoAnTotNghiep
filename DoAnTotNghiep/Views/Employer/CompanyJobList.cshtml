@model IEnumerable<DoAnTotNghiep.Models.ResponseDTO.JobPostingResponseDto>

@{
    ViewData["Title"] = "Danh sách tuyển dụng của tôi";
}
<div class="card mb-4 rounded">
    <div class="card-body">
        <h2 class="card-title">Danh sách tuyển dụng của tôi</h2>

        @if (TempData.ContainsKey("SuccessMessage"))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        @if (TempData.ContainsKey("ErrorMessage"))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <div class="card-deck">
            @if (Model.Any())
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Ảnh</th>
                            <th>Tiêu đề</th>
                            <th>Chức vụ</th>
                            <th>Địa điểm</th>
                            <th>Lương</th>
                            <th>DS Ứng tuyển</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var jobPosting in Model)
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("Company", "Home", new { @id = jobPosting.CompanyId })">
                                        <img src="@jobPosting.Image" alt="@jobPosting.Title" style="max-width: 100px; max-height: 100px;">
                                    </a>
                                </td>
                                <td>
                                    <a href="@Url.Action("DetailJob", "Search", new { @id = jobPosting.JobId })">
                                        <h4>@jobPosting.Title</h4>
                                    </a>
                                </td>
                                <td>@jobPosting.Position</td>
                                <td><i class="fas fa-map-marker-alt"></i> @jobPosting.Location</td>
                                <td>@jobPosting.Salary VND</td>
                                <td>
                                    <a class="genric-btn info radius" href="@Url.Action("ApplyList", "Employer", new { @JobId = jobPosting.JobId })">DS Ứng tuyển</a>
                                </td>
                                <td>
                                    <button class="genric-btn danger radius">Xóa</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>Bạn chưa đăng tin tuyển dụng nào.</p>
            }
        </div>
        <a class="btn btn-success" asp-controller="Employer" asp-action="CreateJobPosting">Đăng tin tuyển dụng</a>
        <a class="btn btn-danger" asp-controller="Employer" asp-action="ListJobPostings">Đăng danh sách tin tuyển dụng</a>
    </div>
</div>