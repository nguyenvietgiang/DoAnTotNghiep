@model IEnumerable<DoAnTotNghiep.Models.EntityModels.JobApplyForm>

@{
    ViewData["Title"] = "Danh sách đơn ứng tuyển";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Số lượng ứng tuyển (2)</h4>
        <button class="genric-btn info radius mb-3">Xuất file thống kê</button>
        @if (Model.Any())
        {
            <table class="table table-striped table-bordered">
                <thead class="thead-dark">
                    <tr>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Bản CV</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var jobApplyForm in Model)
                    {
                        <tr>
                            <td>@jobApplyForm.Name</td>
                            <td>@jobApplyForm.Email</td>
                            <td>@jobApplyForm.PhoneNumber</td>
                            <td>
                                <button type="button" class="genric-btn success radius" data-toggle="modal" data-target="#exampleModal">
                                    Xem CV
                                </button>
                            </td>
                            <td>
                                <button class="genric-btn warning radius">Liên hệ</button>
                                <button class="genric-btn danger radius">Xóa</button>
                            </td>
                        </tr>
                        <!-- Modal -->
                        <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="exampleModalLabel">Hồ sơ, Mẫu CV</h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        <embed src="@jobApplyForm.CVFile" type="application/pdf" width="460" height="600" />
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>Chưa có đơn ứng tuyển nào.</p>
        }
    </div>
</div>
