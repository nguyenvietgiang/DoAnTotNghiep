@model IEnumerable<DoAnTotNghiep.Models.EntityModels.JobApplyForm>

@{
    ViewData["Title"] = "Danh sách đơn ứng tuyển";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Số lượng ứng tuyển (@ViewBag.NumberOfForms)</h4>
        <button class="genric-btn info radius mb-3">Xuất file thống kê</button>
        <partial name="_Message_area" />
        @if (Model.Any())
        {
            <table class="table table-striped table-bordered">
                <thead class="thead-dark">
                    <tr>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Bản CV</th>
                        <th>Thao tác</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var jobApplyForm in Model)
                    {
                        <tr>
                            <td>@jobApplyForm.Name</td>
                            <td>@jobApplyForm.Email</td>
                            <td>@jobApplyForm.PhoneNumber</td>
                            <td style="width: 150px;">
                                <button type="button" class="genric-btn success radius" data-toggle="modal" data-target="#exampleModal-@jobApplyForm.JobApplyID">
                                    Xem CV
                                </button>
                            </td>
                            <td style="width: 300px;">
    <div class="d-flex justify-content-between align-items-center">
        <button type="button" class="genric-btn warning radius" data-toggle="modal" data-target="#contactModal-@jobApplyForm.JobApplyID">
            Duyệt
        </button>
        <form asp-action="DeleteApply" asp-route-jobApplyID="@jobApplyForm.JobApplyID" method="post">
            <button type="submit" class="genric-btn danger radius" onclick="return confirm('Bạn có muốn xóa không?');">Xóa</button>
        </form>
    </div>
</td>
                            <td>@(jobApplyForm.Status ? "Đã duyệt" : "Chưa duyệt")</td>
                        </tr>
                        <!-- CV Modal -->
                        <div class="modal fade" id="exampleModal-@jobApplyForm.JobApplyID" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="exampleModalLabel">Hồ sơ, Mẫu CV</h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        <embed src="@jobApplyForm.CVFile" type="application/pdf" width="460" height="600" />
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Contact Modal -->
                        <div class="modal fade" id="contactModal-@jobApplyForm.JobApplyID" tabindex="-1" role="dialog" aria-labelledby="contactModalLabel" aria-hidden="true">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="contactModalLabel">Liên hệ ứng tuyển</h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        <form asp-action="JobContactResponse" method="post">
                                            <input type="hidden" name="id" value="@jobApplyForm.JobApplyID" />
                                            <div class="form-group">
                                                <label for="message-text" class="col-form-label">Nội dung thư liên hệ:</label>
                                                <textarea name="repcontent" placeholder="Nhập nội dung" class="form-control" id="message-text"></textarea>
                                            </div>
                                            <div class="form-group">
                                                <button type="submit" class="btn btn-primary">Gửi Ngay</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>Chưa có đơn ứng tuyển nào.</p>
        }
    </div>
</div>

