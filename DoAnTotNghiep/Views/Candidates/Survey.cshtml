@{
    ViewData["Title"] = "Khảo sát ứng viên";
}

<div class="mx-0 mx-sm-auto">
    <div class="card">
        <div class="modal-body">
            <div class="text-center">
                <i class="far fa-file-alt fa-4x mb-3 text-primary"></i>
                <p>
                    <strong>Khảo sát ứng viên</strong>
                </p>
                <p>
                    Hãy đưa ra ý kiến của bạn để giúp các doanh nghiệp cải thiện
                    <strong>Cảm ơn đóng góp của bạn.</strong>
                </p>
            </div>

            <hr />

            <form class="px-4">
                <div class="mb-4">
                    <p><strong>Intern nên có lương không?</strong></p>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="exampleForm" id="radio3Example1" />
                        <label class="form-check-label" for="radio3Example1">
                            Đồng ý
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="exampleForm" id="radio3Example2" />
                        <label class="form-check-label" for="radio3Example2">
                            Không quan tâm
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="exampleForm" id="radio3Example3" />
                        <label class="form-check-label" for="radio3Example3">
                            Không đồng ý
                        </label>
                    </div>
                </div>

                <div class="mb-4">
                    <p><strong>Bạn đánh giá cao môi trường làm việc linh hoạt và khả năng làm việc từ xa?</strong></p>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="exampleForm" id="radio3Example4" />
                        <label class="form-check-label" for="radio3Example4">
                            Đồng ý
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="exampleForm" id="radio3Example5" />
                        <label class="form-check-label" for="radio3Example5">
                            Không quan tâm
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="exampleForm" id="radio3Example6" />
                        <label class="form-check-label" for="radio3Example6">
                            Không đồng ý
                        </label>
                    </div>
                </div>

                <div class="mb-4">
                    <p><strong>Bạn đánh giá cao môi trường làm việc linh hoạt và khả năng làm việc từ xa?</strong></p>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="exampleForm" id="radio3Example7" />
                        <label class="form-check-label" for="radio3Example7">
                            Đồng ý
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="exampleForm" id="radio3Example8" />
                        <label class="form-check-label" for="radio3Example8">
                            Không quan tâm
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="exampleForm" id="radio3Example9" />
                        <label class="form-check-label" for="radio3Example9">
                            Không đồng ý
                        </label>
                    </div>
                </div>
            </form>
        </div>
        <div class="card-footer text-end">
            <button type="button" class="btn btn-primary">Gửi khảo sát</button>
        </div>
    </div>
</div>
