@model IPagedList<DoAnTotNghiep.Models.EntityModels.CvLibrary>
@using X.PagedList
@{
    ViewData["Title"] = "Quản lý CV";
}
<div class="container">
    <a asp-action="CreateCvOnline" class="genric-btn primary">Tạo CV Trực Tiếp</a>
    <a asp-action="MyCvOnline" class="genric-btn primary">Danh sách CV của tôi</a>
    <div class="text-center"><h2>- Dùng Sẵn Các Mẫu CV Phổ Biến -</h2></div>
    <div class="row">
     @foreach (var cv in Model)
        {
            <div class="col-md-4 mb-4">
    <div class="card" style="width: 18rem;">
        <img src="@cv.CvImage" class="card-img-top">
        <div class="card-body">
            <h5 class="card-title">@cv.CvName</h5>
                <!-- Button trigger modal -->
                        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#exampleModal-@cv.CvID">
                    Xem Demo
                </button>
                <!-- Modal -->
                        <div class="modal fade" id="exampleModal-@cv.CvID" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLabel">Mẫu CV đẹp</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <img src="@cv.CvImage" style="width:450px; height:650px">
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                                <a class="btn btn-primary" asp-action="DownloadCv" asp-route-cvId="@cv.CvID">Tải về</a>
                            </div>
                        </div>
                    </div>
                </div>
        </div>
    </div>
    </div>
        }
        </div>
</div>
<div class="pagination d-flex justify-content-center">
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" href="@Url.Action("CreateCV", new { page = Model.PageNumber - 1 })" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
            @for (int i = 1; i <= Model.PageCount; i++)
            {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("CreateCV", new { page = i })">@i</a>
                        </li>
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" href="@Url.Action("CreateCV", new { page = Model.PageNumber + 1 })" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>