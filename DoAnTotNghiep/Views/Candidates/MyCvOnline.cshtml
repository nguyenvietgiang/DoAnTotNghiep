@model List<DoAnTotNghiep.Models.EntityModels.OnlineResume>

@{
    ViewData["Title"] = "CV của tôi";
}

<h2>Danh sách các bản ghi</h2>

@if (Model.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>Tên</th>
                <th>Email</th>
                <th>Vị trí</th>
                <th>Xem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var resume in Model)
            {
                <tr>
                    <td>@resume.Name</td>
                    <td>@resume.email</td>
                    <td>@resume.poisition</td>
                    <td><a asp-controller="Resume" class="btn btn-secondary" asp-action="index" asp-route-id="@resume.ID">Xem chi tiết</a></td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Không có bản ghi nào.</p>
}
