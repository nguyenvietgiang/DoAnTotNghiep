@using DoAnTotNghiep.Models.ResponseDTO;
@model List<DoAnTotNghiep.Models.EntityModels.JobPosting>

@{
    ViewData["Title"] = "Báo cáo thống kê thị trường tuyển dụng";
    var surveysWithMostCommonOptions = ViewBag.surveysWithMostCommonOptions as List<dynamic>;
    var topEmployers = ViewBag.TopEmployers as List<EmployerJobPostCount>;
   }
<div class="container mt-5">
    <div class="row">
        <!-- Phần bên trái -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <!-- Nội dung của phần bên trái -->
                    <h2 class="card-title">Bảng Top 5 Công Việc Có Mức Lương Cao Nhất</h2>
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">Công việc</th>
                                <th scope="col">Mức lương</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in Model)
                            {
                                <tr>
                                    <td>@job.Title</td>
                                    <td>@job.Salary</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div>
                    <h2>Top 3 công ty tuyển dụng</h2>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Công ty</th>
                                <th>Số lượng tuyển dụng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var employer in topEmployers)
                            {
                                <tr>
                                    <td>@employer.CompanyName</td>
                                    <td>@employer.JobPostCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div>
                    <h2>Thống kê khảo sát</h2>
                    @if (ViewBag.SurveysWithMostCommonOptions != null && ViewBag.SurveysWithMostCommonOptions.Count > 0)
                    {
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Khảo sát</th>
                                    <th class="text-right">Số người tham gia</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in ViewBag.SurveysWithMostCommonOptions)
                                {
                                    <tr>
                                        <td><a class="black-color" asp-action="Detail" asp-route-id="@item.Survey.SurveyId">@item.Survey.Title</a></td>
                                        <td class="text-right">3 người</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>Danh sách trống.</p>
                    }
                </div>
            </div>
        </div>
        <!-- Phần bên phải -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title">Báo cáo thống kê</h2>
                    <div class="chart-container">
                        <canvas id="pieChart" width="200" height="100"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
     <script>
        // Hàm để gọi API và cập nhật biểu đồ
        async function updateChart() {
            try {
                const response = await fetch('/api/Job/positions/count');
                const data = await response.json();

                const config = {
                    type: 'pie',
                    data: {
                        labels: Object.keys(data),
                        datasets: [{
                            data: Object.values(data),
                            backgroundColor: [
                                'rgba(75, 192, 192, 0.2)',
                                'rgba(255, 99, 132, 0.2)',
                                'rgba(255, 206, 86, 0.2)',
                            ],
                            borderColor: [
                                'rgba(75, 192, 192, 1)',
                                'rgba(255, 99, 132, 1)',
                                'rgba(255, 206, 86, 1)',
                            ],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        plugins: {
                            title: {
                                display: true,
                                text: 'Top công việc được tuyển dụng nhiều nhất'
                            }
                        }
                    }
                };

                var myChart = new Chart(
                    document.getElementById('pieChart'),
                    config
                );
            } catch (error) {
                console.error('Error fetching data:', error);
            }
        }

        // Gọi hàm để cập nhật biểu đồ khi trang được tải
        updateChart();
     </script>
}


