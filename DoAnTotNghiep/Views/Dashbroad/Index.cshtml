@model List<DoAnTotNghiep.Models.EntityModels.JobPosting>

@{
    ViewData["Title"] = "Báo cáo thống kê thị trường tuyển dụng";
    var surveysWithMostCommonOptions = ViewBag.surveysWithMostCommonOptions as List<dynamic>;
   }
<div class="container mt-5">
    <div class="row">
        <!-- Phần bên trái -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <!-- Nội dung của phần bên trái -->
                    <h2 class="card-title">Bảng Top 5 Công Việc Có Mức Lương Cao Nhất</h2>
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">Công việc</th>
                                <th scope="col">Mức lương</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in Model)
                            {
                                <tr>
                                    <td>@job.Title</td>
                                    <td>@job.Salary</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div>
                        @if (surveysWithMostCommonOptions != null)
                        {
                            @foreach (dynamic item in surveysWithMostCommonOptions)
                            {
                                <h2>@item.Survey.Title</h2>
                                <ul>
                                    <li>Câu hỏi: @item.QuestionWithMostCommonOption.Question.QuestionText</li>
                                    <li>Đáp án được chọn nhiều nhất: @item.QuestionWithMostCommonOption.MostCommonOption.OptionText</li>
                                    <li>Số lần xuất hiện: @item.QuestionWithMostCommonOption.MostCommonOption.AnswerCounts.Count</li>
                                </ul>
                            }
                        }
                        else
                        {
                            <p>Danh sách trống.</p>
                        }

                </div>
            </div>
        </div>
        <!-- Phần bên phải -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title">Báo cáo thống kê</h2>
                    <div class="chart-container">
                        <canvas id="pieChart" width="200" height="100"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
     <script>
        // Hàm để gọi API và cập nhật biểu đồ
        async function updateChart() {
            try {
                const response = await fetch('/api/Job/positions/count');
                const data = await response.json();

                const config = {
                    type: 'pie',
                    data: {
                        labels: Object.keys(data),
                        datasets: [{
                            data: Object.values(data),
                            backgroundColor: [
                                'rgba(75, 192, 192, 0.2)',
                                'rgba(255, 99, 132, 0.2)',
                                'rgba(255, 206, 86, 0.2)',
                            ],
                            borderColor: [
                                'rgba(75, 192, 192, 1)',
                                'rgba(255, 99, 132, 1)',
                                'rgba(255, 206, 86, 1)',
                            ],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        plugins: {
                            title: {
                                display: true,
                                text: 'Top công việc được tuyển dụng nhiều nhất'
                            }
                        }
                    }
                };

                var myChart = new Chart(
                    document.getElementById('pieChart'),
                    config
                );
            } catch (error) {
                console.error('Error fetching data:', error);
            }
        }

        // Gọi hàm để cập nhật biểu đồ khi trang được tải
        updateChart();
     </script>
}


