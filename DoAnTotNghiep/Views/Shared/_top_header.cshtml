<div class="language-copyright-section" style="background-color: #28395a;">
    <div class="container">
        <div class="row justify-content-center align-items-center">
            <div class="col-md-6 text-center" style="padding-bottom: 5px; padding-top: 5px;">
                <div class="single-element-widget">
                    <div class="row justify-content-center">
                        <div class="col-md-6">
                            @{
                                var routeValues = ViewContext.RouteData.Values;
                                var action = routeValues["action"].ToString();
                                var controller = routeValues["controller"].ToString();
                                var id = routeValues["id"]?.ToString();
                            }

                            @Html.ActionLink("Vietnamese", action, controller, new { language = "vie", id }, new { @style = "color: #fff;" })
                            ||
                            @Html.ActionLink("English", action, controller, new { language = "en", id }, new { @style = "color: #fff;" })
                            ||
                            @Html.ActionLink("French", action, controller, new { language = "fr", id }, new { @style = "color: #fff;" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
