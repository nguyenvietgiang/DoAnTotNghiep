<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DoAnTotNghiep</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/flaticon.css" rel="stylesheet" />
    <link href="~/css/price_rangs.css" rel="stylesheet" />
    <link href="~/css/slicknav.css" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" />
    <link href="~/css/slick.css" rel="stylesheet" />
    <link href="~/css/nice-select.css" rel="stylesheet" />
    <link href="~/css/magnific-popup.css" rel="stylesheet" />
    <link href="~/css/animate.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/DoAnTotNghiep.styles.css" asp-append-version="true" />
    <link href="~/css/main.css" rel="stylesheet" /> @*tùy chỉnh css thì vào đây*@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
    <div id="preloader-active">
        <div class="preloader d-flex align-items-center justify-content-center">
            <div class="preloader-inner position-relative">
                <div class="preloader-circle"></div>
                <div class="preloader-img pere-text">
                    <img src="~/local-img/logo.png" />
                </div>
            </div>
        </div>
    </div>
    <!-- Preloader Start -->
    <header>
        <!-- Header Start -->
        <div class="header-area header-transparrent">
            <div class="headder-top header-sticky">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-3 col-md-2">
                            <!-- Logo -->
                            <div class="logo">
                                <a asp-controller="Home" asp-action="index"><img src="~/local-img/logo.png" alt=""></a>
                            </div>
                        </div>
                        <div class="col-lg-9 col-md-9">
                            <div class="menu-wrapper">
                                <!-- Main-menu -->
                                <div class="main-menu">
                                    <nav class="d-none d-lg-block">
                                        <ul id="navigation">
                                            <li><a asp-controller="Home" asp-action="index">Trang Chủ</a></li>
                                            <li><a asp-controller="Home" asp-action="Hiring">Tuyển Dụng </a></li>
                                            <li>
                                                <a href="#">Danh sách</a>
                                                <ul class="submenu">
                                                    <li><a asp-controller="Home" asp-action="EmployerList">Danh sách công ty</a></li>
                                                    <li><a asp-controller="Home" asp-action="CandidatesList">Danh sách ứng viên</a></li>
                                                </ul>
                                            </li>
                                            <li><a asp-controller="Home" asp-action="Forum">Diễn Đàn</a></li>
                                            <li><a asp-controller="Home" asp-action="Contact">Liên Hệ</a></li>
                                            @{
                                                if (@Context.Session.GetString("EmployerName") != null)
                                                {
                                                    <li>
                                                        <a href="#">Chào: @Context.Session.GetString("EmployerName")</a>
                                                        <ul class="submenu">
                                                            <li><a asp-controller="Employer" asp-action="CompanyProfile">Thông tin doanh nghiệp</a></li>
                                                            <li><a asp-controller="Employer" asp-action="CompanyJobList">Danh sách tuyển dụng</a></li>
                                                            <li><a asp-controller="Dashbroad" asp-action="Index">Báo cáo thống kê</a></li>
                                                            <li><a asp-controller="Survey" asp-action="Index">Khảo sát</a></li>
                                                            <li><a asp-controller="Auth" asp-action="ChangePass">Đổi mật khẩu</a></li>
                                                            <li>
                                                                <button type="button" class="genric-btn link" data-toggle="modal" data-target="#exampleModalCenter">
                                                                    Đăng xuất
                                                                </button>
                                                            </li>
                                                        </ul>
                                                    </li>

                                                }
                                                else if (@Context.Session.GetString("CandidateName") != null)
                                                {
                                                    <li>
                                                        <a href="#">Chào: @Context.Session.GetString("CandidateName")</a>
                                                        <ul class="submenu">
                                                            <li><a asp-controller="Candidates" asp-action="Profile">Thông tin cá nhân</a></li>
                                                            <li><a asp-controller="Candidates" asp-action="CreateCV">Quản lý CV</a></li>
                                                            <li><a asp-controller="Dashbroad" asp-action="Index">Báo cáo thống kê</a></li>
                                                            <li><a asp-controller="Survey" asp-action="Index">Khảo sát</a></li>
                                                            <li><a asp-controller="Auth" asp-action="ChangePass">Đổi mật khẩu</a></li>
                                                            <li>
                                                                <button type="button" class="genric-btn link" data-toggle="modal" data-target="#exampleModalCenter">
                                                                    Đăng xuất
                                                                </button>
                                                            </li>
                                                        </ul>
                                                    </li>
                                                }
                                                else
                                                {
                                                    <li><a asp-controller="Auth" asp-action="Login">Đăng Nhập</a></li>
                                                    <li><a asp-controller="Auth" asp-action="Register">Đăng Ký</a></li>
                                                }
                                            }
                                        </ul>
                                    </nav>
                                </div>

                                <!-- Modal -->
                                <div class="modal fade" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered" role="document">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="exampleModalLongTitle">Đăng xuất tài khoản?</h5>
                                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                    <span aria-hidden="true">&times;</span>
                                                </button>
                                            </div>
                                            <div class="modal-body">
                                                <p>Bạn có chắc chắn rằng mình muốn đăng xuất khỏi hệ thống không ?</p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                                                <a asp-controller="Auth" asp-action="Logout" class="btn btn-primary">Đăng xuất</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <!-- Mobile Menu -->
                        <div class="col-12">
                            <div class="mobile_menu d-block d-lg-none"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Header End -->
    </header>
    <partial name="_Breadcrumb" />
    <main>
        @RenderBody()
    </main>
    <footer class="mt-4">
        <!-- Footer Start-->
        <div class="footer-area footer-bg">
            <div class="container">
                <!--  -->
                <div class="row footer-wejed justify-content-between">
                    <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6">
                        <!-- logo -->
                        <div class="footer-logo mb-20">
                            <a href="index.html"><img src="~/local-img/logo2_footer.png" alt=""></a>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-4 col-sm-5">
                        <div class="footer-tittle-bottom">
                            <span>Email:</span>
                            <p>Vietgiang111001@gmail.com</p>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-4 col-sm-5">
                        <div class="footer-tittle-bottom">
                            <span>Liên hệ:</span>
                            <p>0946783295</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- footer-bottom area -->
        <div class="footer-bottom-area footer-bg">
            <div class="container">
                <div class="footer-border">
                    <div class="row d-flex justify-content-between align-items-center">
                        <div class="col-xl-10 col-lg-10 ">
                            <div class="footer-copy-right">
                                <p>
                                    Create By: <a href="https://vietgiangblog.blogspot.com/">Nguyễn Việt Giang</a> | Đồ Án Tốt Nghiệp 2024 | <a asp-area="Manage" asp-controller="ManageDashbroad" asp-action="Index">Trang Quản Trị</a>
                                </p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <!-- Footer End-->
    </footer>
    <!-- JS here -->
    <!-- All JS Custom Plugins Link Here here -->
    <script src="~/js/vendor/modernizr-3.5.0.min.js"></script>
    <!-- Jquery, Popper, Bootstrap -->
    <script src="~/js/vendor/jquery-1.12.4.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <!-- Jquery Mobile Menu -->
    <script src="~/js/jquery.slicknav.min.js"></script>

    <!-- Jquery Slick , Owl-Carousel Plugins -->
    <script src="~/js/owl.carousel.min.js"></script>
    <script src="~/js/slick.min.js"></script>
    <script src="~/js/price_rangs.js"></script>

    <!-- One Page, Animated-HeadLin -->
    <script src="~/js/wow.min.js"></script>
    <script src="~/js/animated.headline.js"></script>
    <script src="~/js/jquery.magnific-popup.js"></script>

    <!-- Scrollup, nice-select, sticky -->
    <script src="~/js/jquery.scrollUp.min.js"></script>
    <script src="~/js/jquery.nice-select.min.js"></script>
    <script src="~/js/jquery.sticky.js"></script>

    <script src="//cdn.ckeditor.com/4.20.0/standard/ckeditor.js"></script>
    <script type="text/javascript" src="ckeditor/ckeditor.js"></script>
    <!-- contact js -->
    <script src="~/js/contact.js"></script>
    <script src="~/js/jquery.form.js"></script>
    <script src="~/js/jquery.validate.min.js"></script>
    <script src="~/js/mail-script.js"></script>
    <script src="~/js/jquery.ajaxchimp.min.js"></script>
    <!-- Jquery Plugins, main Jquery -->
    <script src="~/js/plugins.js"></script>
    <script src="~/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://www.gstatic.com/dialogflow-console/fast/messenger/bootstrap.js?v=1"></script>
    <df-messenger chat-icon="https:&#x2F;&#x2F;img.freepik.com&#x2F;premium-vector&#x2F;chat-logo-with-robot-face_1124-277.jpg"
                  intent="WELCOME"
                  chat-title="JobFinder"
                  agent-id="91759a92-8689-4994-98eb-d55c1ede131d"
                  language-code="vi"></df-messenger>
    <div id="fb-root"></div>
    <script async defer crossorigin="anonymous" src="https://connect.facebook.net/vi_VN/sdk.js#xfbml=1&version=v15.0&appId=5546284648741227&autoLogAppEvents=1" nonce="pHaCsEiK"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // tạo QR code đến trang hiện tại
        var previousPageUrl = window.location.href;
        var url = 'https://chart.googleapis.com/chart?cht=qr&chs=300x300&chl=' + encodeURIComponent(previousPageUrl);
        document.getElementById("qrcode").src = url;
        // chia sẻ với facebook (pushlish lên mới được nha)
        function shareOnFacebook() {
            var currentURL = window.location.href;
            var facebookShareURL = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(currentURL);
            window.open(facebookShareURL, '_blank');
        }
        // chia sẻ với twitter
        function shareOnTwitter() {
            var currentURL = window.location.href;
            var twitterShareURL = 'https://twitter.com/intent/tweet?url=' + encodeURIComponent(currentURL);
            window.open(twitterShareURL, '_blank');
        }
    </script>
</body>
</html>
