@model IEnumerable<DoAnTotNghiep.Models.EntityModels.JobPosting>

@{
    ViewData["Title"] = "Danh sách tuyển dụng";
}

<div class="container mt-3">
    <h3>@ViewData["TitleJob"] (@ViewData["JobCount"])</h3>
    <form asp-action="Hiring" method="get">
        <div class="form-row align-items-end">
            <div class="form-group col-md-3">
                <label for="title">Công Việc:</label>
                <input type="text" class="form-control" name="title" />
            </div>
            <div class="form-group col-md-2">   
                <select class="form-control" name="location">
                    <option value="">--Chọn Địa Điểm--</option>
                    <option value="Hà Nội">Hà Nội</option>
                    <option value="Đà Nẵng">Đà Nẵng</option>
                    <option value="TP. HCM">TP. HCM</option>
                </select>
            </div>
            <div class="form-group col-md-2">   
                <select class="form-control" name="salary">
                    <option value="">--Lương Cơ Bản--</option>
                    <option value="Hà Nội">5Tr - 10Tr</option>
                    <option value="Đà Nẵng">Trên 10Tr</option> 
                </select>
            </div>
             <div class="form-group col-md-2">   
                <select class="form-control" name="time">
                    <option value="">--Thời Gian Làm--</option>
                    <option value="Hà Nội">Full Time</option>
                    <option value="Đà Nẵng">Past Time</option> 
                </select>
            </div>
            <div class="form-group col-md-3">
                <button type="submit" class="genric-btn success medium mt-2 form-control"><i class="fas fa-search"></i></button>
            </div>
        </div>
    </form>
    @foreach (var job in Model)
    {
        <div class="single-job-items mb-30">
            <div class="job-items">
                <div class="company-img">
                    <a href="@Url.Action("Conpany", "Home", new { @id = @job.Employer.EmployerID })">
                        <img src="@job.Employer.UrlImage" alt="">
                    </a>
                </div>
                <div class="job-tittle job-tittle2">
                    <a href="@Url.Action("DetailJob", "Search", new { @id = job.JobPostingID })">
                        <h4>@job.Title</h4>
                    </a>
                    <ul>
                        <li>Vị Trí Tuyển Dụng: @job.position</li>
                        <li>Địa Điểm Làm Việc: @job.Location</li>
                        <li>Mức Lương Cơ Bản: @job.Salary VND</li>
                    </ul>
                </div>
            </div>
            <div class="items-link items-link2 f-right">
                <a>@job.WorkingTime</a>
                <span>@job.CreateAt</span>
            </div>
        </div>
    }
</div>
