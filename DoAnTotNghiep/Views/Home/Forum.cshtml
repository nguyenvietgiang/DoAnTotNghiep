@model IEnumerable<DoAnTotNghiep.Models.EntityModels.Discuss>
@{
    ViewData["Title"] = "Diễn Đàn";
}
<div class="container">
    <div class="row">
        <!-- Main content -->
        <div class="col-lg-9 mb-3">
            <div class="row text-left mb-5">
                <div class="col-md-8">
                    <form method="get" action="@Url.Action("Forum", "Home")">
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="Tìm kiếm" name="searchTerm">
                            <button type="submit" class="genric-btn success medium">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <!-- End of post 1 -->
            @foreach(var item in Model)
            {
            <div class="card row-hover pos-relative py-3 px-3 mb-3 border-warning border-top-0 border-right-0 border-bottom-0 rounded-0">
                <div class="row align-items-center">
                    <div class="col-md-8 mb-3 mb-sm-0">
                        <h5>
                                <a asp-action="DetailDiscuss" asp-route-id="@item.DiscussID" class="text-primary">@Html.DisplayFor(modelItem => item.Title)</a>
                        </h5>
                            <div class="text-sm op-5"> <p class="text-black mr-2">Đăng vào: @((item.CreatedAt).ToString("dd/MM/yyyy"))</p> </div>
                            <div class="text-sm op-5"> <p class="text-black mr-2">@item.Account.Email</p> </div>
                    </div>
                    <div class="col-md-4 op-7">
                        <div class="row text-center op-7">
                            <div class="col px-1"> <i class="fa-solid fa-comment"></i> <span class="d-block text-sm">122 Phản hồi </span> </div>
                            <div class="col px-1"> <i class="fa-solid fa-heart"></i> <span class="d-block text-sm">290 Tim</span> </div>
                        </div>
                    </div>
                </div>
            </div>
            }
        </div>
        <!-- Sidebar content -->
        <div class="col-lg-3 mb-4 mb-lg-0 px-lg-0 mt-lg-0">
            <div style="visibility: hidden; display: none; width: 285px; height: 801px; margin: 0px; float: none; position: static; inset: 85px auto auto;"></div><div data-settings="{&quot;parent&quot;:&quot;#content&quot;,&quot;mind&quot;:&quot;#header&quot;,&quot;top&quot;:10,&quot;breakpoint&quot;:992}" data-toggle="sticky" class="sticky" style="top: 85px;">
                <div class="sticky-inner">
                    <a class="btn btn-lg btn-block btn-success rounded-0 py-4 mb-3 bg-op-6 roboto-bold" asp-controller="Candidates" asp-action="CreateDiscuss">Đặt câu hỏi</a>
                </div>
            </div>
        </div>
    </div>
</div>
