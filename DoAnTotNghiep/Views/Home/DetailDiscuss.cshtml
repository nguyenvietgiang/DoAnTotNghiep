@model DoAnTotNghiep.Models.EntityModels.Discuss

@{
    ViewData["Title"] = "Câu hỏi thảo luận";
}

<div class="container">
    <h3>Chủ đề thảo luận trong diễn đàn</h3>
    <div class="row">
        <div class="col-md-8">
            <div class="post-content">
                <div class="post-container">
                    <div class="post-detail">
                        <div class="user-info">
                            <h5><a href="timeline.html" class="profile-link">okooko</a> <span class="following">đặt câu hỏi vào @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span></h5>
                        </div>
                        <div class="line-divider"></div>
                        <div class="post-text">
                               @Html.Raw(Model.Content)
                        </div>
        
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-body text-center">
                <p class="text-dark font-weight-medium mb-0 mr-2">Chia sẻ với:</p>
                <div class="d-inline-flex">
                    <button class="genric-btn primary small" onclick="shareOnFacebook()">
                        <i class="fab fa-facebook-f"></i>
                    </button>
                    |
                    <button class="genric-btn primary small" onclick="shareOnTwitter()">
                        <i class="fab fa-twitter"></i>
                    </button>
                </div>
                </div>
            </div>
    </div>
</div>
