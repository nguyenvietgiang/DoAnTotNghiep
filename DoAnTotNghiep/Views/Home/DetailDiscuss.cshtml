@model DoAnTotNghiep.Models.EntityModels.Discuss

@{
    ViewData["Title"] = "Câu hỏi thảo luận";
}

<div class="container">
    <h3>Chủ đề thảo luận trong diễn đàn</h3>
    <div class="row">
        <div class="col-md-8">
            <div class="post-content">
                <div class="post-container">
                    <div class="post-detail">
                        <div class="user-info">
                            <h5><a href="timeline.html" class="profile-link">@Model.Account.Email</a> <span class="following">đặt câu hỏi vào @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span></h5>
                        </div>
                        <div class="line-divider"></div>
                        <div class="post-text">
                            @Html.Raw(Model.Content)
                        </div>
                        <div class="like-section">
                            <button class="btn btn-block btn-primary"><i class="fa fa-thumbs-up"></i> </button>
                        </div>
                        <div class="comment-form">
                            <h4>Bình luận</h4>
                            <form class="form-contact comment_form" action="#" id="commentForm">
                                <div class="row">
                                    <div class="col-12">
                                        <div class="form-group">
                                            <textarea class="form-control w-100" name="comment" id="comment" cols="30" rows="9"
                                                      placeholder="Bình luận của bạn"></textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <button type="submit" class="button button-contactForm btn_1 boxed-btn">Bình luận</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-body text-center">
                <p class="text-dark font-weight-medium mb-0 mr-2">Mã QR Code:</p>
                <div class="d-inline-flex">
                    <img id="qrcode" src="" alt="QR Code">
                </div>
                <p class="text-dark font-weight-medium mb-0 mr-2">Chia sẻ với:</p>
                <div class="d-inline-flex">
                    <button class="genric-btn primary small" onclick="shareOnFacebook()">
                        <i class="fab fa-facebook-f"></i>
                    </button>
                    |
                    <button class="genric-btn primary small" onclick="shareOnTwitter()">
                        <i class="fab fa-twitter"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<h4>Danh sách bình luận</h4>
<div class="row" id="Comment-list"></div>
<form id="comment-form">
    <label for="comment-content">Comment:</label>
    <input type="text" id="comment-content" required />
    <button type="submit">Add Comment</button>
</form>


@section Scripts {
    <script>
        ﻿$(document).ready(function () {
    function getComments() {
        $.ajax({
            url: 'https://localhost:7235/Home/GetCommentsForDiscuss?discussId=@Model.DiscussID',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                displayComments(data);
            },
            error: function (error) {
                console.log(error);
            }
        });
    }

    function displayComments(comments) {
        var commentTableHtml = '<table class="table"><thead><tr><th>ID</th><th>Content</th><th>Created At</th></tr></thead><tbody>';

        $.each(comments, function (index, comment) {
            commentTableHtml += '<tr>';
            commentTableHtml += '<td>' + comment.content + '</td>';
            commentTableHtml += '<td>' + comment.createdAt + '</td>';
            commentTableHtml += '</tr>';
        });

        commentTableHtml += '</tbody></table>';
        $('#Comment-list').html(commentTableHtml);
    }

    function addComment(comment) {
        $.ajax({
            url: 'https://localhost:7183/admin/Comment/AddComment',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(comment),
            success: function (data) {
                // Refresh the comments after adding a new comment
                getComments();
            },
            error: function (error) {
                console.log(error);
            }
        });
    }

    // Event handler for the form submission
    $('#comment-form').submit(function (event) {
        event.preventDefault();

        var commentContent = $('#comment-content').val();

        // Create a new comment object
        var newComment = {
            content: commentContent,
            userId: '7d987d4e-de06-4696-6fdc-08dbc4e09b03', // đang gán mặc định UserID để tét
            postId: '322098f6-a3e5-4421-a6af-cba394815a30'
        };

        // Call the addComment function to add the new comment
        addComment(newComment);
    });

    // Initial load of comments
    getComments();
});
    </script>
}