@model DoAnTotNghiep.Models.EntityModels.Employer

@{
    ViewData["Title"] = "Hồ Sơ Doanh Nghiệp";
    var GaleryList = (List<DoAnTotNghiep.Models.EntityModels.ImageGalery>)ViewBag.GaleryList;
}

<section style="background-color: #eee;">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-body text-center">
                        <img src="@Model.UrlImage" alt="avatar"
                             class="rounded-circle img-fluid" style="width: 150px;">
                        <h5 class="my-3">@Model.CompanyName</h5>
                        <p class="text-muted mb-1">@Model.Industry</p>
                        <p class="text-muted mb-4">@Model.Location</p>
                        <p>Số người theo dõi: @ViewBag.FollowCount</p>
                        <div class="d-flex justify-content-center mb-2">
                            <a href="@Url.Action("AddFollow", "Home")?followUserId=@Html.DisplayFor(model => model.EmployerID)" class="btn btn-primary">Theo Dõi</a>
                        </div>
                    </div>

                </div>
                <div class="card mb-4">
                    <div class="card-body text-center">
                        <p class="text-dark font-weight-medium mb-0 mr-2">Mã QR Code:</p>
                        <div class="d-inline-flex">
                            <img id="qrcode" src="" alt="QR Code">
                        </div>
                        <p class="text-dark font-weight-medium mb-0 mr-2">Chia sẻ với:</p>
                        <div class="d-inline-flex">
                            <button class="genric-btn primary small" onclick="shareOnFacebook()">
                                <i class="fab fa-facebook-f"></i>
                            </button>
                            |
                            <button class="genric-btn primary small" onclick="shareOnTwitter()">
                                <i class="fab fa-twitter"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row">
                            <div id="carouselExampleControls" class="carousel slide" data-ride="carousel">
                                <div class="carousel-inner">
                                    <div class="carousel-item active">
                                        <img src="~/local-img/h1_hero.jpg" alt="First slide" style="height: 300px; width: 750px">
                                    </div>
                                    @foreach (var item in GaleryList)
                                    {
                                        <div class="carousel-item">
                                            <img src="@item.ImgUrl" alt="Slide" style="height: 300px; width: 750px">
                                        </div>
                                    }
                                </div>
                                <a class="carousel-control-prev" href="#carouselExampleControls" role="button" data-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="sr-only">Previous</span>
                                </a>
                                <a class="carousel-control-next" href="#carouselExampleControls" role="button" data-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="sr-only">Next</span>
                                </a>
                            </div>
                        </div>
                        <div class="row pt-5">
                            <div class="col-sm-3">
                                <p class="mb-0">Số điện thoại liên hệ</p>
                            </div>
                            <div class="col-sm-9">
                                <p class="text-muted mb-0">@Model.PhoneNumber</p>
                            </div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-sm-3">
                                <p class="mb-0">Số lượng nhân viên</p>
                            </div>
                            <div class="col-sm-9">
                                <p class="text-muted mb-0">@Model.CompanySize<p>
                            </div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-sm-3">
                                <p class="mb-0">Lĩnh vự hoạt động</p>
                            </div>
                            <div class="col-sm-9">
                                <p class="text-muted mb-0">@Model.Industry<p>
                            </div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-sm-3">
                                <p class="mb-0">Mô tả:</p>
                            </div>
                            <div class="col-sm-9">
                                @Html.Raw(Model.Descrpitons)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>