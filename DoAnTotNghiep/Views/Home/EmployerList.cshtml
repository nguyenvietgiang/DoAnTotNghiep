@model IPagedList<DoAnTotNghiep.Models.EntityModels.Employer>
@using X.PagedList
@{
    ViewData["Title"] = "Danh sách công ty";
}

<div class="container mt-5 pt-4">
    <div class="row align-items-end mb-4 pb-2">
        <div class="col-md-8">
            <div class="section-title text-center text-md-start">
                <h4 class="title mb-4">Các công ty liên kết với chúng tôi</h4>
                <p class="text-muted mb-0 para-desc">Tìm kiếm những doanh nghiệp tiềm năng phù hợp với nhu cầu và khả năng của bạn</p>
            </div>
        </div><!--end col-->

        <div class="col-md-4 mt-4 mt-sm-0">
            <form method="get" action="@Url.Action("EmployerList", "Home")">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Tìm công ty" name="searchTerm">
                    <button type="submit" class="genric-btn success medium">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>
        </div>

    </div><!--end row-->

    <div class="row">
        @foreach (var employer in Model)
        {
            <div class="col-lg-4 col-md-6 col-12 mt-4 pt-2">
                <div class="card border-0 bg-light rounded shadow">
                    <div class="d-flex align-items-center">
                        <img src="@employer.UrlImage" class="card-img-top rounded-circle" alt="Avatar" style="width: 90px; height: 90px;">
                        <div class="card-body p-4">
                            <span class="badge rounded-pill bg-primary float-md-end mb-3 mb-sm-0">@employer.Industry</span>
                            <h5>@employer.CompanyName</h5>
                            <div class="mt-3">
                                <span class="text-muted d-block"><i class="fa fa-map-marker" aria-hidden="true"></i> @employer.Location</span>
                            </div>

                            <div class="mt-3">
                                <a href="@Url.Action("Conpany", "Home", new { @id = employer.EmployerID })" class="btn btn-primary">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div><!--end row-->
</div>
<div class="pagination d-flex justify-content-center">
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" href="@Url.Action("EmployerList", new { page = Model.PageNumber - 1 })" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
            @for (int i = 1; i <= Model.PageCount; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("EmployerList", new { page = i })">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" href="@Url.Action("EmployerList", new { page = Model.PageNumber + 1 })" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>

