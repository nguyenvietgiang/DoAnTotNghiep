@{
    ViewData["Title"] = "Job Finder";
}
<!-- slider Area Start-->
<div class="slider-area ">
    <!-- Mobile Menu -->
    <div class="slider-active">
        <div class="single-slider slider-height d-flex align-items-center" data-background="/local-img/h1_hero.jpg">
            <div class="container">
                <div class="row">
                    <div class="col-xl-6 col-lg-9 col-md-10">
                        <div class="hero__caption">
                            <h1>Trao cơ hội kết nối ước mơ</h1>
                        </div>
                    </div>
                </div>
                <!-- Search Box -->
                <div class="row">
                    <div class="col-xl-8">
                        <!-- form -->
                        <form asp-controller="Search" asp-action="SearchJob" method="post" class="search-box">
                            <div class="input-form">
                                <input type="text" name="searchTerm" placeholder="Tìm kiếm công việc">
                            </div>
                            <div class="select-form">
                                <div class="select-itms">
                                    <select name="location">
                                        <option value="">Tất cả</option>
                                        <option value="Hà Nội">Hà Nội</option>
                                        <option value="Đà Nẵng">Đà Nẵng</option>
                                        <option value="TP Hồ Chí Minh">TP Hồ Chí Minh</option>
                                    </select>
                                </div>
                            </div>
                            <button type="submit" class="search-form btn btn-success">Tìm Kiếm</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- slider Area End-->
<!-- Our Services Start -->
<div class="our-services section-pad-t30">
    <div class="container">
        <!-- Section Tittle -->
        <div class="row">
            <div class="col-lg-12">
                <div class="section-tittle text-center">
                    <span>Chúng Tôi Đem Lại Cơ Hội Thăng Tiến</span>
                    <h2>Vô Vàn Cơ Hội Đang Chờ Bạn</h2>
                </div>
            </div>
        </div>
        <div class="row d-flex justify-contnet-center">
            <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6">
                <div class="single-services text-center mb-30">
                    <i class="fa-solid fa-paint-roller"></i>
                    <div class="services-cap">
                        <h5><a href="job_listing.html">Công việc Design & Creative</a></h5>
                        <span>(653)</span>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6">
                <div class="single-services text-center mb-30">
                    <i class="fa-solid fa-code"></i>
                    <div class="services-cap">
                        <h5><a href="job_listing.html"> Công việc Design & Development</a></h5>
                        <span>(658)</span>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6">
                <div class="single-services text-center mb-30">
                    <i class="fa-solid fa-business-time"></i>
                    <div class="services-cap">
                        <h5><a href="job_listing.html">Công việc Sales & Marketing</a></h5>
                        <span>(658)</span>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6">
                <div class="single-services text-center mb-30">
                    <i class="fa-solid fa-people-roof"></i>
                    <div class="services-cap">
                        <h5><a href="job_listing.html">Công việc quản lý</a></h5>
                        <span>(658)</span>
                    </div>
                </div>
            </div>
        </div>
        <!-- More Btn -->
        <!-- Section Button -->
        <div class="row">
            <div class="col-lg-12">
                <div class="browse-btn2 text-center mt-50">
                    <a href="job_listing.html" class="border-btn2">Xem Tất Cả</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Our Services End -->