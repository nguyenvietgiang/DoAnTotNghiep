@model DoAnTotNghiep.Models.DTO.ContactViewModel
@{
    ViewData["Title"] = "Liên hệ";
}
<div class="container">
    <section class="mb-4">

        <!--Section heading-->
        <h2 class="h1-responsive font-weight-bold text-center my-4">Liên hệ / Phản hồi</h2>
        <!--Section description-->
        <p class="text-center w-responsive mx-auto mb-5">
            Mọi thắc mắc hoặc yêu cầu tư vấn xin để lại tại đây, chúng tôi sẽ ghi nhận và giải đáp cho bạn.
        </p>

        <div class="row">
            <div class="col-md-9 mb-md-0 mb-5">
                <form asp-action="Contact" asp-controller="Home" method="post">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="md-form mb-0">
                                <input type="text" asp-for="Name" class="form-control" placeholder="Tên của bạn">
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="md-form mb-0">
                                <input type="text" asp-for="Email" class="form-control" name="email" placeholder="Email của bạn">
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="md-form mb-0">
                                <input type="text" asp-for="Subject" name="subject" class="form-control" placeholder="Vấn đề">
                                <span asp-validation-for="Subject" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="md-form">
                                <textarea type="text" asp-for="Message" rows="2" class="form-control md-textarea"></textarea>
                                <span asp-validation-for="Message" class="text-danger"></span>
                            </div>

                        </div>
                    </div>
                    <div class="text-center text-md-left">
                        <button type="submit" class="btn btn-primary">Gửi</button>
                    </div>
                    <p style="color: red">@ViewBag.thongbao</p>
                </form>
               
            </div>
            <!--Grid column-->
            <div class="col-md-3 text-center">
                <ul class="list-unstyled mb-0">
                    <li>
                        <i class="fas fa-map-marker-alt fa-2x"></i>
                        <p>96 Định Công, Hà Nội</p>
                    </li>

                    <li>
                        <i class="fas fa-phone mt-4 fa-2x"></i>
                        <p>0946783295</p>
                    </li>

                    <li>
                        <i class="fas fa-envelope mt-4 fa-2x"></i>
                        <p>vietgiang111001@gmail.com</p>
                    </li>
                </ul>
            </div>
        </div>

    </section>
</div>
