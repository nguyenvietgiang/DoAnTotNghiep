@model DoAnTotNghiep.Models.EntityModels.Survey

@{
    ViewData["Title"] = "Thực hiện khảo sát";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card rounded-0">
                <div class="card-body">
                    <h2 class="mb-4">@Model.Title</h2>
                    <form method="post" asp-action="SubmitSurvey">
                        @foreach (var question in Model.Questions)
                        {
                            <h3>@question.QuestionText</h3>
                            <div class="form-check">
                                @foreach (var option in question.Options)
                                {
                                    <input type="radio" class="form-check-input" name="@question.QuestionId" id="@option.OptionId" value="@option.OptionId" />
                                    <label class="form-check-label" for="@option.OptionId">@option.OptionText</label>
                                    <br />
                                }
                            </div>
                            <br />
                        }
                        <button type="submit" class="btn btn-primary">Gửi</button>
                        <input type="hidden" name="SurveyId" value="@Model.SurveyId" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
