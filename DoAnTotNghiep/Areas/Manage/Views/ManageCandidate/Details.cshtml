@model DoAnTotNghiep.Models.EntityModels.Candidate

@{
    ViewData["Title"] = "Chi Tiết Tin Ứng viên";
    Layout = "~/Areas/Manage/Views/Shared/_AdminLayout.cshtml";

}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-body">
                    <h1 class="card-title">@Model.Name</h1>
                    <hr />

                    <dl class="row">
                        <dt class="col-sm-4">Ngày sinh:</dt>
                        <dd class="col-sm-8">@Model.DateOfBirth</dd>

                        <dt class="col-sm-4">Chuyên ngành:</dt>
                        <dd class="col-sm-8">@Model.Industry</dd>

                        <dt class="col-sm-4">Học vấn:</dt>
                        <dd class="col-sm-8"> @Model.EducationLevel</dd>

                        <dt class="col-sm-4">Số năm kinh nghiệm:</dt>
                        <dd class="col-sm-8">@Model.Experience</dd>

                        <dt class="col-sm-4">Số điện thoại:</dt>
                        <dd class="col-sm-8">@Model.PhoneNumber</dd>

                        <dt class="col-sm-4">Mô tả:</dt>
                        <dd class="col-sm-8"> @Html.Raw(Model.Descrpitons)</dd>
                    </dl>
                </div>
                <a class="btn btn-primary" href="@Url.Action("Index")">Trở về</a>
            </div>
        </div>
    </div>
</div>

