@model DoAnTotNghiep.Models.EntityModels.Discuss

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Manage/Views/Shared/_AdminLayout.cshtml";
     @addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
    @addTagHelper *, AuthoringTagHelpers
}

<h2>Câu hỏi thảo luận</h2>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Tiêu đề
        </dt>
        <dd class="col-sm-10">
            @Model.Title
        </dd>
        <dt class="col-sm-2">
            Nội dung thảo luận
        </dt>
        <dd class="col-sm-10">
            @Html.Raw(Model.Content)
        </dd>
        <dt class="col-sm-2">
            Loại
        </dt>
        <dd class="col-sm-10">
            @Model.Type
        </dd>
        <dt class="col-sm-2">
            Ngày đăng
        </dt>
        <dd class="col-sm-10">
            @Model.CreatedAt
        </dd>
        <dt class="col-sm-2">
            Trạng thái
        </dt>
        <dd class="col-sm-10">
            @(Model.Status ? "Active" : "Inactive")
        </dd>
    </dl>
    <form asp-action="DeleteConfirmed" asp-route-id="@Model.DiscussID" method="post">
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="Index">Quay lại</a>
    </form>
</div>
