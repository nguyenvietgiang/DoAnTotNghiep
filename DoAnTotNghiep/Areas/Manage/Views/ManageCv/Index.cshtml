@model IPagedList<DoAnTotNghiep.Models.EntityModels.CvLibrary>
@using X.PagedList
@{
    ViewData["Title"] = "Danh sách CV mẫu";
   ViewData["Title"] = "Index";
    Layout = "~/Areas/Manage/Views/Shared/_AdminLayout.cshtml";
    @addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
    @addTagHelper *, AuthoringTagHelpers
}

<h2>Danh sách CV mẫu</h2>
<p>
    <a asp-action="Create" class="btn btn-primary" role="button">Tạo mới</a>
</p>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên mẫu</th>
            <th>Kiểu</th>
            <th>Ảnh mô tả</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cv in Model)
        {
            <tr>
                <td>@cv.CvName</td>
                <td>@cv.CvType</td>
                <td><img src="@cv.CvImage" alt="Cv Image" width="100" height="100" /></td>
                <td>
                     <a href="@Url.Action("Delete", "ManageCv", new { @id = cv.CvID })" class="btn btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="pagination">
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber - 1 })" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
            @for (int i = 1; i <= Model.PageCount; i++)
            {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                    </li>
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber + 1 })" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>
