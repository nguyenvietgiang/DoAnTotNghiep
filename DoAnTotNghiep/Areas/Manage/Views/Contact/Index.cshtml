@model IPagedList<DoAnTotNghiep.Models.EntityModels.Contact>
@using X.PagedList
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Manage/Views/Shared/_AdminLayout.cshtml";
}
<h2>Danh sách Phản hồi / Góp ý</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên</th>
            <th>Vấn đề</th>
            <th>Góp ý</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var contact in Model)
        {
            <tr>
                <td>@contact.Name</td>
                <td>@contact.Subject</td>
                <td>@contact.Message</td>
                @if(contact.Status == true)
                {
                    <td>Đã Phản Hồi</td>
                }
                else
                {
                    <td>Chưa Phản Hồi</td>
                }
                <td>
                    <a href="@Url.Action("Delete", "Contact", new { @id = contact.Id })" class="btn btn-danger">Xóa</a>
                    <a href="@Url.Action("ContactResponse", "Contact", new { @id = contact.Id })" class="btn btn-info">
                        Phản hồi
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="pagination">
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber - 1 })" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
            @for (int i = 1; i <= Model.PageCount; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber + 1 })" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>

