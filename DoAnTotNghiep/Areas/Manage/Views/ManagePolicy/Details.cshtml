@model DoAnTotNghiep.Models.EntityModels.Policy

@{
    ViewData["Title"] = "Detail";
    Layout = "~/Areas/Manage/Views/Shared/_AdminLayout.cshtml";
    @addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
    @addTagHelper *, AuthoringTagHelpers
}

<h2>Chi Tiết Chính Sách</h2>

<div>
    <h4>Thông Tin Chính Sách</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Tiêu Đề:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PolicyTitle)
        </dd>
        <dt class="col-sm-2">
            Nội Dung:
        </dt>
        <dd class="col-sm-10">
            @Html.Raw(Model.Content)
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Index">Quay Lại Danh Sách</a>
</div>

