@model DoAnTotNghiep.Models.EntityModels.Policy

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Areas/Manage/Views/Shared/_AdminLayout.cshtml";
    @addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
    @addTagHelper *, AuthoringTagHelpers
}

<h2>Xác Nhận Xóa Chính Sách</h2>

<div>
    <h4>Bạn có chắc chắn muốn xóa chính sách sau không?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Tiêu Đề:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PolicyTitle)
        </dd>
        <dt class="col-sm-2">
            Nội Dung:
        </dt>
        <dd class="col-sm-10">
           @Html.Raw(Model.Content)
        </dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" asp-route-id="@Model.PolicyID" method="post">
    <input type="submit" value="Xóa" class="btn btn-danger" /> |
    <a asp-action="Index">Quay Lại Danh Sách</a>
</form>
