</div>

<div class="card border-primary mb-3">
    <div class="card-header bg-primary text-white">
        Tin tuyển dụng chờ duyệt
    </div>
    <div class="card-body">
        <table id="jobTable" class="table">
            <thead>
                <tr>
                    <th>Tiêu đề</th>
                    <th>Vị trí</th>
                    <th>Công ty</th>
                    <th>Ảnh</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Function to create the "Duyệt" button
            function createActionButton(jobId, actionType, buttonText) {
                return `<button class="btn btn-${actionType}" data-job-id="${jobId}">${buttonText}</button>`;
            }

            // Function to handle the action button click
            function handleActionButtonClick() {
                var jobId = $(this).data('job-id');
                var actionType = $(this).hasClass('btn-approve') ? 'approve' : 'delete';

                // Call the corresponding API based on the action type
                var apiUrl = actionType === 'approve'
                    ? `/api/job/togglestatus/${jobId}`
                    : `/api/job/${jobId}`;

                var successCallback = function () {
                    // Remove the row from the table on success
                    $(`#jobTable tr[data-job-id="${jobId}"]`).remove();
                };

                $.ajax({
                    type: actionType === 'approve' ? 'POST' : 'DELETE',
                    url: apiUrl,
                    success: successCallback,
                    error: function (error) {
                        console.log(error);
                    }
                });
            }

            $.ajax({
                type: 'GET',
                url: '/api/job',
                success: function (data) {
                    $.each(data, function (index, job) {
                        var row = `
                            <tr data-job-id="${job.jobId}">
                                <td>${job.title}</td>
                                <td>${job.position}</td>
                                <td>${job.company}</td>
                                <td><img src="${job.image}" alt="Company Image" width="50"></td>
                                <td>
                                    ${createActionButton(job.jobId, 'approve', 'Duyệt')}
                                    
                                </td>
                            </tr>`;

                        $('#jobTable tbody').append(row);
                    });

                    // Attach click event to the action buttons
                    $('.btn-approve, .btn-delete').on('click', handleActionButtonClick);
                },
                error: function (error) {
                    console.log(error);
                }
            });
        });
        // chart thống kê doanh thu
        $(document).ready(function () {
            var currentChart = null; // Biến để lưu trữ biểu đồ hiện tại

            // Hàm để cập nhật biểu đồ với năm được chọn
            function updateChart(selectedYear) {
                if (currentChart) {
                    currentChart.destroy(); // Hủy biểu đồ hiện tại nếu tồn tại
                }

                $.ajax({
                    url: '@Url.Action("GetRevenueData", "ManageDashbroad")',
                    type: 'GET',
                    data: { selectedYear: selectedYear },
                    success: function (data) {
                        var dates = [];
                        var amounts = [];
                        data.forEach(function (item) {
                            dates.push(item.date);
                            amounts.push(item.amount);
                        });

                        var ctx = document.getElementById('revenueChart').getContext('2d');
                        currentChart = new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: dates,
                                datasets: [{
                                    label: 'Doanh Thu',
                                    data: amounts,
                                    backgroundColor: 'rgba(54, 162, 235, 0.2)',
                                    borderColor: 'rgba(54, 162, 235, 1)',
                                    borderWidth: 1
                                }]
                            },
                            options: {
                                scales: {
                                    xAxes: [{
                                        type: 'category',
                                        labels: dates
                                    }],
                                    yAxes: [{
                                        ticks: {
                                            beginAtZero: true
                                        }
                                    }]
                                }
                            }
                        });
                    }
                });
            }

            // Sự kiện để cập nhật biểu đồ khi người dùng thay đổi năm
            $('#yearSelect').change(function () {
                var selectedYear = $(this).val();
                updateChart(selectedYear);
            });

            // Lấy năm hiện tại và cập nhật biểu đồ ban đầu
            var currentYear = (new Date()).getFullYear();
            $('#yearSelect').val(currentYear);
            updateChart(currentYear);
        });
    </script>
    <script src="~/js/manage/chart/chart-pie-demo.js"></script>

}
